# Copy to android/keystore.properties (gitignored) and fill in. NEVER commit the real file or
# the keystore. Any value missing here falls back to an environment variable:
# YANSIT_KEYSTORE, YANSIT_STORE_PASSWORD, YANSIT_KEY_ALIAS, YANSIT_KEY_PASSWORD.
# storeFile is relative to android/.
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=yansit
keyPassword=CHANGE_ME
